# PostgreSQL (docker-compose.yml starts one on localhost:5432 for development)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buconnect?schema=public"

# Signs login sessions; at least 32 random characters (openssl rand -base64 32)
JWT_SECRET=""

# Supabase (production). DATABASE_URL above becomes the transaction pooler
# (port 6543): postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL is the direct/session connection (port 5432), used by prisma migrate
DIRECT_URL=""

# Profile pictures go to a public Supabase Storage bucket named "avatars".
# Server-only: never expose the service role key with a NEXT_PUBLIC_ prefix.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
